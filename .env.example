# AI features (adaptive questions and workflow tailoring). Copy this file to
# .env and fill it in. These values are read only by the local dev server.
# They are never sent to the browser, because they do not start with VITE_.
# Do not rename them to VITE_...

# Your OpenAI API key, from platform.openai.com/api-keys
OPENAI_API_KEY=

# The model that tailors the n8n workflow (and adapts the questions, unless
# OPENAI_FAST_MODEL is set)
OPENAI_MODEL=gpt-6-luna

# Optional: a faster or cheaper model for adapting the questions
OPENAI_FAST_MODEL=

# Optional: the embedding model used to recognise tasks seen before
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
