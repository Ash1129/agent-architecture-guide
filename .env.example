# AI features (adaptive questions and workflow tailoring). Copy this file to
# .env and fill it in. These values are read only by the local dev server.
# They are never sent to the browser, because they do not start with VITE_.
# Do not rename them to VITE_...

# Your Anthropic API key, from platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Only if the key isn't scoped to a workspace: the workspace ID to bill
# (Claude Console > Settings > Workspaces). Sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# Every AI step answers first on ANTHROPIC_MODEL, except tailoring, which starts
# on ANTHROPIC_ESCALATION_MODEL. An answer that fails the step's checks gets one
# retry on ANTHROPIC_ESCALATION_MODEL. Only
# claude-haiku-5-5 and claude-sonnet-5-5 are allowed; empty means these defaults.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_ESCALATION_MODEL=claude-sonnet-5-5

# Optional: recognise tasks seen before by meaning. Claude has no embedding
# model, so this uses OpenAI; leave the key empty to skip it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: report each AI call's model, tokens and step to Revenium (usage only, no prompts).
REVENIUM_METERING_API_KEY=
REVENIUM_METERING_BASE_URL=https://api.revenium.ai
REVENIUM_SUBSCRIBER_EMAIL=
