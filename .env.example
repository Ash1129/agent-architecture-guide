# AI tailoring for the starter kit. Copy this file to .env and fill it in.
# These values are read only by the server (the Vite dev server locally, or
# the /api function when deployed). They are never sent to the browser,
# because they do not start with VITE_. Do not rename them to VITE_...

# Your OpenAI API key, from platform.openai.com/api-keys
OPENAI_API_KEY=

# The model that tailors the workflows
OPENAI_MODEL=gpt-6.1-sol
